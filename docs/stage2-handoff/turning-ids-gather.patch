+def turning_ids():
+    """The ids of the movers and doors a runtime source may have turned: a
+    set holding every brush whose transform (:func:`runtime_of`) turns now,
+    or ``None`` when a source cannot say. Worked out once per pair of
+    placement stamps from the sources' own ``turning_ids``, so a reader that
+    only has to tell a turned brush from one that is not -- the player's
+    gather, keeping box movers on the AABB path -- asks one set instead of
+    resolving every mover. An id it holds may not turn (it is a superset,
+    across all sources): resolve it to be sure; one it does not hold does
+    not turn."""
+    global _turning
+    stamps = placement_stamps
+    cached = _turning
+    if cached[0] is stamps:
+        return cached[1]
+    ids = NOTHING_TURNS
+    for ref in _sources:
+        source = ref()
+        if source is None:
+            continue
+        turned = getattr(source, 'turning_ids', None)
+        if turned is None:
+            ids = None
+            break
+        if turned:
+            # Copied (in C, whole): the source keeps changing its own set.
+            ids = ids | turned
+    _turning = (stamps, ids)
+    return ids
+
