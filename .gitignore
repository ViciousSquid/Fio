__pycache__/
*.py[cod]
.pytest_cache/

# Regenerated from engine/shaders.py:DEFAULT_SHADERS every time a renderer is
# constructed (see ShaderLoader._ensure_defaults), so it is build output rather
# than source. The visual test tier creates it too.
assets/shaders/

# Audit working files (regenerate with git rev-list)
audit/_commits*.txt

# Temporary level pair the level-changer e2e test writes (and removes) while
# it runs (tests/e2e/test_level_changer_spawns.py).
maps/_e2e_*.json
