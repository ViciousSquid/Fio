# Tidy plugin book model (UV-mapped: cover on front/back, pages on edges).
# Per-instance cover comes from the entity's 'texture' property.
mtllib book.mtl
o tidy_book
v -7.000 -10.000 -2.500
v 7.000 -10.000 -2.500
v 7.000 10.000 -2.500
v -7.000 10.000 -2.500
v -7.000 -10.000 2.500
v 7.000 -10.000 2.500
v 7.000 10.000 2.500
v -7.000 10.000 2.500
vt 0.0200 0.0300
vt 0.7000 0.0300
vt 0.7000 0.9700
vt 0.0200 0.9700
vt 0.8000 0.0500
vt 0.9600 0.0500
vt 0.9600 0.9500
vt 0.8000 0.9500
vn 0.0 0.0 1.0
vn 0.0 0.0 -1.0
vn -1.0 0.0 0.0
vn 1.0 0.0 0.0
vn 0.0 1.0 0.0
vn 0.0 -1.0 0.0
usemtl cover
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1
f 1/1/2 2/2/2 3/3/2
f 1/1/2 3/3/2 4/4/2
f 1/5/3 4/8/3 8/7/3
f 1/5/3 8/7/3 5/6/3
f 2/5/4 6/6/4 7/7/4
f 2/5/4 7/7/4 3/8/4
f 4/5/5 3/6/5 7/7/5
f 4/5/5 7/7/5 8/8/5
f 1/5/6 5/6/6 6/7/6
f 1/5/6 6/7/6 2/8/6
