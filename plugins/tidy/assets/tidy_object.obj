# Tidy plugin default carryable object: a small book-shaped box.
# Half-extents: X=7 (width), Y=10 (height), Z=2.5 (thickness). Centred at origin.
mtllib tidy_object.mtl
o tidy_object
v -7.0 -10.0 -2.5
v  7.0 -10.0 -2.5
v  7.0  10.0 -2.5
v -7.0  10.0 -2.5
v -7.0 -10.0  2.5
v  7.0 -10.0  2.5
v  7.0  10.0  2.5
v -7.0  10.0  2.5
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0 -1.0  0.0
vn  0.0  1.0  0.0
usemtl tidy_object
f 1//1 3//1 2//1
f 1//1 4//1 3//1
f 5//2 6//2 7//2
f 5//2 7//2 8//2
f 1//3 5//3 8//3
f 1//3 8//3 4//3
f 2//4 3//4 7//4
f 2//4 7//4 6//4
f 1//5 2//5 6//5
f 1//5 6//5 5//5
f 4//6 8//6 7//6
f 4//6 7//6 3//6
